{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "preview build",
      "type": "npm",
      "script": "preview",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "release patch (bug fix)",
      "type": "npm",
      "script": "release:patch",
      "problemMatcher": []
    },
    {
      "label": "release minor (new feature)",
      "type": "npm",
      "script": "release:minor",
      "problemMatcher": []
    },
    {
      "label": "release major (breaking change)",
      "type": "npm",
      "script": "release:major",
      "problemMatcher": []
    }
  ]
}
